"rule.trash.user.title" = "清倒废纸篓";
"rule.trash.user.explanation" = "已经删除、放进废纸篓的项目。放在这里期间仍然占用同样的磁盘空间。";
"rule.trash.user.consequence" = "会被彻底删除。只有这一项无法撤销。";

"rule.xcode.derivedData.title" = "Xcode 构建中间产物（DerivedData）";
"rule.xcode.derivedData.explanation" = "各项目的构建缓存和索引。用 Xcode 的话，这是膨胀最快的文件夹。";
"rule.xcode.derivedData.consequence" = "下次构建时自动重新生成。该项目的首次构建和首次索引会变慢。";

"rule.xcode.iosDeviceSupport.title" = "iOS 设备支持文件";
"rule.xcode.iosDeviceSupport.explanation" = "用真机调试时 Xcode 从设备取回并保存的符号文件。每个 iOS 版本一套，每套 1–2GB。在开发者的 Mac 上这通常是膨胀最厉害的文件夹。";
"rule.xcode.iosDeviceSupport.consequence" = "再次连接该 iOS 版本的设备时 Xcode 会重新获取（需要几分钟）。一般只保留当前设备所用的版本。";

"rule.xcode.watchOSDeviceSupport.title" = "watchOS 设备支持文件";
"rule.xcode.watchOSDeviceSupport.explanation" = "用于 Apple Watch 真机调试的符号文件。";
"rule.xcode.watchOSDeviceSupport.consequence" = "再次连接该设备时会重新获取。";

"rule.xcode.tvOSDeviceSupport.title" = "tvOS 设备支持文件";
"rule.xcode.tvOSDeviceSupport.explanation" = "用于 Apple TV 真机调试的符号文件。";
"rule.xcode.tvOSDeviceSupport.consequence" = "再次连接该设备时会重新获取。";

"rule.xcode.archives.title" = "Xcode 归档";
"rule.xcode.archives.explanation" = "提交到 App Store 或 TestFlight 的构建归档，里面含有 dSYM（符号文件）。";
"rule.xcode.archives.consequence" = "⚠️ 要解析已发布版本的崩溃日志，需要那个版本的 dSYM。只在构建未发布、或已另行备份 dSYM 时才删除。";

"rule.xcode.cache.title" = "Xcode 自身的缓存";
"rule.xcode.cache.explanation" = "Xcode 自用的一般缓存。";
"rule.xcode.cache.consequence" = "Xcode 会自行重新生成。";

"rule.xcode.iosSoftwareUpdates.title" = "iOS 恢复镜像（.ipsw）";
"rule.xcode.iosSoftwareUpdates.explanation" = "恢复或更新 iPhone / iPad 时下载的固件文件，每个 7–10GB。";
"rule.xcode.iosSoftwareUpdates.consequence" = "需要时会重新下载。大多数不会再用第二次。";

"rule.simulator.dyldCache.title" = "模拟器 dyld 缓存";
"rule.simulator.dyldCache.explanation" = "为加快模拟器启动而生成的缓存。";
"rule.simulator.dyldCache.consequence" = "下次启动模拟器时重新生成，仅那一次会变慢。";

"rule.dev.npmCache.title" = "npm 缓存";
"rule.dev.npmCache.explanation" = "npm 下载并保留的软件包 tarball。";
"rule.dev.npmCache.consequence" = "下次安装时重新下载。只是安装稍慢，不影响运行。";

"rule.dev.yarnCache.title" = "Yarn 缓存";
"rule.dev.yarnCache.explanation" = "Yarn 下载并保留的软件包。";
"rule.dev.yarnCache.consequence" = "下次安装时重新下载。";

"rule.dev.pnpmStore.title" = "pnpm 存储库";
"rule.dev.pnpmStore.explanation" = "pnpm 只存一份软件包、再用硬链接接入各个项目的存储库。";
"rule.dev.pnpmStore.consequence" = "⚠️ 删除会**破坏所有已安装项目的 node_modules 链接。** 需要在每个项目里重新运行 `pnpm install`。";

"rule.dev.pipCache.title" = "pip 缓存";
"rule.dev.pipCache.explanation" = "pip 下载并保留的 wheel 文件。";
"rule.dev.pipCache.consequence" = "下次安装时重新下载。";

"rule.dev.homebrewCache.title" = "Homebrew 下载缓存";
"rule.dev.homebrewCache.explanation" = "用 brew 安装时下载的原始文件仍留在这里。";
"rule.dev.homebrewCache.consequence" = "重新安装时会再次下载。已安装的程序本身不受影响。";

"rule.dev.swiftpmCache.title" = "Swift Package Manager 缓存";
"rule.dev.swiftpmCache.explanation" = "SPM 下载的软件包仓库缓存。";
"rule.dev.swiftpmCache.consequence" = "下次解析（resolve）时重新下载。";

"rule.dev.cocoapodsCache.title" = "CocoaPods 缓存";
"rule.dev.cocoapodsCache.explanation" = "CocoaPods 下载并保留的库。";
"rule.dev.cocoapodsCache.consequence" = "下次 `pod install` 时重新下载。";

"rule.dev.puppeteerChromium.title" = "Puppeteer / Playwright 浏览器";
"rule.dev.puppeteerChromium.explanation" = "为自动化测试下载的 Chromium 构建，每个版本一套。";
"rule.dev.puppeteerChromium.consequence" = "下次使用该工具时会重新下载。";

"rule.cache.userCaches.title" = "App 缓存";
"rule.cache.userCaches.explanation" = "各个 App 存放可重新生成的临时数据的地方。";
