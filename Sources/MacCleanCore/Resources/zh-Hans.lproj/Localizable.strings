"rule.dev.flutterEngineCache.title" = "Flutter 引擎缓存";
"rule.dev.flutterEngineCache.explanation" = "Flutter SDK 按版本下载的引擎二进制文件。";
"rule.dev.flutterEngineCache.consequence" = "下次构建时重新下载。";

