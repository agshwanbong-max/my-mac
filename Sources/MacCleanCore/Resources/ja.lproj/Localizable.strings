"rule.browser.firefoxCache.consequence" = "ページの初回読み込みが少し遅くなります。";

"rule.mail.downloads.title" = "メール添付の一時コピー";
"rule.mail.downloads.explanation" = "メールで添付ファイルを開いたときに作られる一時コピーです。メール本体と元の添付ファイルはそのまま残ります。";
"rule.mail.downloads.consequence" = "添付ファイルを再度開けば作り直されます。メールから消えるものはありません。";

"rule.downloads.oldInstallers.title" = "古いインストーラ";
"rule.downloads.oldInstallers.explanation" = "ダウンロードフォルダに残ったインストール用のディスクイメージやパッケージです。インストール済みなら通常は不要です。";
"rule.downloads.oldInstallers.consequence" = "ゴミ箱に移動します。必要ならゴミ箱から戻せます。";

"rule.advice.quicklookThumbnails.title" = "クイックルックのサムネイルキャッシュ";
"rule.advice.quicklookThumbnails.explanation" = "Finder のプレビュー用サムネイルキャッシュです。システムが管理する一時フォルダにあります。";
"rule.advice.quicklookThumbnails.consequence" = "自分で消すには下のコマンドをターミナルで実行してください。サムネイルは必要に応じて作り直されます。";

/* ループでアプリごとに作るルール。%@ はアプリ・フォルダ名。 */
"rule.appsupport.cache.title" = "アプリ内部のキャッシュ（%@）";
"rule.appsupport.cache.explanation" = "アプリが自分のフォルダ内に作ったキャッシュです。設定・ログイン状態・書類は別のフォルダなので影響しません。";
"rule.appsupport.cache.consequence" = "アプリが必要なときに作り直します。次に開くとき一瞬遅くなることがあります。";

"rule.appsupport.partitionCache.title" = "%@ のパーティションキャッシュ";
"rule.appsupport.partitionCache.explanation" = "%@ が Web コンテンツごとに分けて作ったキャッシュです。";
"rule.appsupport.partitionCache.consequence" = "アプリが作り直します。";
