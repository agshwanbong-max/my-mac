"breakdown.hint.wallpaper" = "macOS video wallpaper and screen saver assets. Several GB each, and they stay even after you stop using them. Switching to a still image under System Settings → Wallpaper lets macOS clean them up on its own. This is a system-managed area, so the app does not delete it directly.";
"breakdown.hint.claude" = "Mostly virtual machine images (rootfs.img) inside vm_bundles. These are live images the app uses, not caches, so this app leaves them alone. If you don't need them, turn the feature off in the app's settings and let it clean up after itself. The Cache / Code Cache / GPUCache inside are handled as cleanup targets.";
"breakdown.hint.electron" = "An Electron app's data folder. The Cache / Code Cache / GPUCache inside are handled as cleanup targets. The rest is sign-in state and local data, so it is left alone.";
"breakdown.hint.chrome" = "A Chrome profile. It holds history, bookmarks, passwords and extensions, so this app leaves it alone. When it gets big, it is usually OptGuideOnDeviceModel (on-device AI models, several GB) and the updater cache. Clear it from Chrome: Settings → Privacy → Delete browsing data → Cached images and files.";
"breakdown.hint.developer" = "Where Xcode lives. DerivedData, iOS device support files and archives all land here. The fastest-growing folder on a developer's Mac.";
"breakdown.hint.coreSimulator" = "Simulator devices and runtimes. Remove versions you don't use under Xcode → Settings → Platforms.";
"breakdown.hint.appSupport" = "Where apps keep their real data. This is data, not cache, so most of it is left alone.";
"breakdown.hint.xcodeShared" = "Used by Xcode and the simulators.";
"breakdown.hint.caches" = "App caches. This is the area the app treats as a cleanup target.";
"breakdown.hint.containers" = "Data belonging to sandboxed apps. Only the caches are cleanup targets; the rest is app data.";
"breakdown.hint.groupContainers" = "Data shared between several apps. It is app data, so it is left alone.";
"breakdown.hint.pictures" = "Your photo library. Clean it up in the Photos app.";
"breakdown.hint.downloads" = "Your Downloads folder. Old installers are treated as cleanup targets.";
"breakdown.hint.userFiles" = "Your own files. This app never touches them.";
"breakdown.hint.generic" = "What is using the space. This app does not touch this folder.";

