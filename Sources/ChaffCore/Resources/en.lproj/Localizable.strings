"systemArea.hint.libraryCaches" = "Caches used by the whole system. macOS counts this as 'System Data'. It needs administrator privileges, so this app leaves it alone.";
"systemArea.hint.libraryAppSupport" = "App data shared by all users. Adobe, virtual machines and developer tools take up a lot of room here. Counted as 'System Data'.";
"systemArea.hint.libraryDeveloper" = "Developer tools installed system-wide. From Xcode 15 on, simulator runtimes live here. Remove versions you don't use under Xcode → Settings → Platforms.";
"systemArea.hint.libraryLogs" = "System logs. Usually not large.";
"systemArea.hint.varFolders" = "A system-managed temporary folder. A reboot clears much of it. Counted as 'System Data'.";
"systemArea.installedApp.detail" = "Installed app · /Applications";
